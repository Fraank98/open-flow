{
  "name": "open-flow",
  "version": "0.3.2",
  "description": "Local-first dictation app for macOS — Whisper + LLM cleanup",
  "author": "Danilo Franco",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "fetch-binaries": "bash scripts/fetch-binaries.sh",
    "fetch-test-models": "bash scripts/fetch-test-models.sh",
    "lint": "eslint --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts' 'tools/**/*.ts'",
    "typecheck": "tsc --noEmit --project tsconfig.main.json && tsc --noEmit --project tsconfig.preload.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "smoke": "tsx tools/pipeline-smoke.ts",
    "clean": "rimraf dist",
    "build:main": "tsc --project tsconfig.main.json",
    "build:preload": "tsc --project tsconfig.preload.json",
    "build": "npm run clean && npm run build:main && npm run build:preload",
    "dev": "npm run build && electron dist/main/index.js",
    "package": "npm run build && npx install-electron --no && electron-builder --mac dmg --arm64",
    "rebuild-native": "electron-rebuild -f --arch arm64",
    "ax-probe": "tsc --project tsconfig.tools.json && electron dist-tools/tools/ax-context-probe.js",
    "reply-bench": "tsx tools/reply-classifier-bench.ts",
    "reply-pipeline-bench": "tsx tools/reply-pipeline-bench.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.9.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "node-addon-api": "^8.7.0"
  }
}
